# 复制为 .env；不要把密钥粘贴到终端命令、聊天或可提交文件。
# 官方 OpenAI API；此型号为 M0 起步建议，是否有权限和额度以真实调用为准。
# base URL 包含 /v1，不能填聊天网页地址。
WO_MODEL_BASE_URL=https://api.openai.com/v1
WO_MODEL_NAME=gpt-6-luna
WO_MODEL_API=responses
# 其他兼容服务可设 WO_MODEL_API=chat-completions
WO_MODEL_API_KEY=
# 公开搜索先复用 OpenAI Key；设为 tavily 时需要单独配置下面的 Key。
WO_SEARCH_PROVIDER=openai
TAVILY_API_KEY=
# 可选：本地 MCP 配置路径（相对于当前工作目录）
WO_MCP_CONFIG=configs/mcp.local.toml
# M1 本地业务数据（均在被 Git 忽略的目录）
WO_DATABASE_PATH=data/app.db
WO_RAW_DIRECTORY=data/raw/m1
# 可选部署模式；两项同时填写。公网Origin必须HTTPS，访问口令至少32字符。
# 留空保持仅本机模式。不要把真实口令加入版本库或终端日志。
WO_PUBLIC_ORIGIN=
WO_ACCESS_TOKEN=
